---
import '../styles/global.css';
import { SITE } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '室内写真から作るAI内覧動画',
  serviceType: '不動産の内覧イメージ動画制作',
  description: SITE.description,
  url: SITE.url,
  areaServed: { '@type': 'Country', name: '日本' },
  provider: {
    '@type': 'Organization',
    name: SITE.operator,
    url: SITE.businessUrl,
    email: SITE.mail,
  },
  offers: {
    '@type': 'Offer',
    price: 8000,
    priceCurrency: 'JPY',
    description: '写真6枚まで。7枚目から1枚ごとに1,000円',
  },
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.title}</title>
    <meta name="description" content={SITE.description} />
    <link rel="canonical" href={SITE.url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1c283a" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={SITE.operator} />
    <meta property="og:title" content={SITE.title} />
    <meta property="og:description" content={SITE.description} />
    <meta property="og:url" content={SITE.url} />
    <meta property="og:image" content={new URL('/ogp.jpg', SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="image" href="/media/hero.jpg" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
