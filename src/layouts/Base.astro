---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;      // canonical に使う（例 '/contact/'）
  noindex?: boolean;
  jsonLd?: boolean;   // サービスの構造化データを出すか（トップだけ）
}
const { title = SITE.title, description = SITE.description, path = '/', noindex = false, jsonLd: withJsonLd = true } = Astro.props;
const canonical = new URL(path, SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '室内写真から作るAI内覧動画',
  serviceType: '不動産の内覧イメージ動画制作',
  description: SITE.description,
  url: SITE.url,
  areaServed: { '@type': 'Country', name: '日本' },
  provider: {
    '@type': 'Organization',
    name: SITE.operator,
    url: SITE.businessUrl,
    email: SITE.mail,
  },
  offers: {
    '@type': 'Offer',
    price: 8000,
    priceCurrency: 'JPY',
    description: '写真6枚まで。7枚目から1枚ごとに1,000円',
  },
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1c283a" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={SITE.operator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/ogp-move.jpg', SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
    {import.meta.env.PROD && (
      <>
        {/* アクセス解析（GA4）。ブログ www.macmariya.com と同じプロパティに送り、レポートはホスト名で分ける。
            提案メールのリンクには相手ごとに ?utm_source= を付ける。自分の閲覧は ?no_ga=1 を一度開くとこのブラウザで送らなくなる（?no_ga=0 で戻す） */}
        <script is:inline>
          (function () {
            var ID = 'G-M8F6S44L6B';
            try {
              var q = new URLSearchParams(location.search).get('no_ga');
              if (q === '1') localStorage.setItem('no_ga', '1');
              if (q === '0') localStorage.removeItem('no_ga');
              if (localStorage.getItem('no_ga') === '1') return;
            } catch (e) {}
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ID;
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            window.gtag('config', ID);
          })();
        </script>
      </>
    )}
    {withJsonLd &&<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
