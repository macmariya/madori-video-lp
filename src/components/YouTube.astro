---
// クリックするまで YouTube を読み込まない埋め込み（初期表示を軽くし、閲覧だけで Cookie を送らない）。
// 再生ボタンを押すと youtube-nocookie.com の iframe に差し替える。JS が無い環境では YouTube へのリンクとして動く。
import type { Video } from '../data/site';
interface Props { video: Video; eager?: boolean }
const { video, eager = false } = Astro.props;
---
<div class="yt">
  <a
    class="yt-facade"
    href={`https://www.youtube.com/watch?v=${video.id}`}
    data-yt={video.id}
    data-title={video.title}
    aria-label={`動画を再生: ${video.title}`}
  >
    <img src={video.poster} alt="" width="960" height="540" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    <span class="yt-play" aria-hidden="true">
      <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 12.9.1 24 .1 24s0 11.1 1.4 16.3a8.5 8.5 0 0 0 6 6c5.2 1.4 26.5 1.4 26.5 1.4s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35.1 67.9 24 67.9 24s0-11.1-1.4-16.3z" fill="#e87828"/><path d="M45 24 27 14v20z" fill="#fff"/></svg>
    </span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.yt-facade').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${a.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = a.dataset.title ?? '';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      a.replaceWith(iframe);
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: #111;
  }
  .yt :global(iframe),
  .yt-facade,
  .yt-facade img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .yt-facade img { object-fit: cover; transition: transform 0.4s ease; }
  .yt-facade:hover img { transform: scale(1.02); }
  .yt-play {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    filter: drop-shadow(0 4px 12px rgb(0 0 0 / 0.35));
    transition: scale 0.2s ease;
  }
  .yt-facade:hover .yt-play,
  .yt-facade:focus-visible .yt-play { scale: 1.1; }
  .yt-facade:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
</style>
