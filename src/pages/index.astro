---
import Base from '../layouts/Base.astro';
import YouTube from '../components/YouTube.astro';
import FlowExample from '../components/FlowExample.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  SITE, MAIN_VIDEO, SIZE_VIDEOS, PRICES, OPTIONS, DELIVERABLES, FLOW, FAQ,
} from '../data/site';
---
<Base>
  <link slot="head" rel="preload" as="image" href="/media/hero-move.jpg" fetchpriority="high" />
  <SiteHeader />

  <main>
    <!-- ヒーロー -->
    <section class="hero">
      <video
        class="hero-video"
        src="/media/hero-move.mp4"
        poster="/media/hero-move.jpg"
        autoplay muted loop playsinline
        preload="metadata"
        aria-hidden="true"
      ></video>
      <div class="hero-shade"></div>
      <div class="wrap hero-inner">
        <p class="pill">不動産会社・工務店さま向け</p>
        <h1 class="hero-title">
          <span class="hero-title-sub">室内写真から作る</span>
          AI内覧動画
        </h1>
        <p class="hero-lead">
          お手持ちの室内写真と間取り図から、部屋の中を歩いて見て回る「内覧イメージ動画」をお作りします。動画の撮影に行かずに物件紹介の動画を用意したい、不動産会社さま・工務店さま・リフォーム会社さま向けのサービスです。
        </p>
        <ul class="hero-facts">
          <li><span class="fact-k">料金</span><span class="fact-v">写真6枚まで 8,000円</span></li>
          <li><span class="fact-k">納期</span><span class="fact-v">初稿まで 3営業日</span></li>
          <li><span class="fact-k">対応</span><span class="fact-v">石川県から全国</span></li>
        </ul>
        <div class="hero-cta">
          <a class="btn btn-accent" href={SITE.contactUrl}>無料で見積もりを依頼する</a>
          <a class="btn btn-ghost" href="#examples">制作例を見る</a>
        </div>
      </div>
      <p class="ai-badge">AI生成映像</p>
      <p class="hero-caption">映像は架空の物件（図面・室内写真もAIで生成）の制作例です</p>
    </section>

    <!-- 写真 → 映像 -->
    <section class="section" id="how">
      <div class="wrap">
        <p class="eyebrow">写真が、そのまま内覧映像に</p>
        <h2>部屋ごとに約10秒、歩いて見て回る映像にします</h2>
        <p class="section-lead">
          間取り図から部屋の立体を起こし、写真に写っている窓・扉・設備の位置に合わせて、部屋の中を歩く映像や戸口を通って隣の部屋へ入る映像にします。左がお送りいただく写真、右が納品する映像の一部です。
        </p>

        <div class="compare-list">
          <figure class="compare">
            <div class="compare-pair">
              <div class="compare-item">
                <span class="compare-tag">写真</span>
                <img src="/media/photo-move-kitchen.jpg" alt="壁付けI型キッチンの室内写真。3口コンロとシンク、グレージュの扉と吊戸棚、左に木目の扉" width="1280" height="853" loading="lazy" decoding="async" />
              </div>
              <span class="compare-arrow" aria-hidden="true"></span>
              <div class="compare-item">
                <span class="compare-tag compare-tag-accent">映像</span>
                <video src="/media/compare-move-kitchen.mp4" poster="/media/compare-move-kitchen.jpg" muted loop playsinline preload="none" data-autoplay aria-label="同じキッチンを、部屋の中を歩いて近づきながら映した映像"></video>
              </div>
            </div>
            <figcaption>キッチン：部屋の中を歩いてキッチンに近づく</figcaption>
          </figure>

          <figure class="compare">
            <div class="compare-pair">
              <div class="compare-item">
                <span class="compare-tag">写真</span>
                <img src="/media/photo-move-room.jpg" alt="洋室の室内写真。正面に腰窓、左に白いクローゼット" width="1280" height="853" loading="lazy" decoding="async" />
              </div>
              <span class="compare-arrow" aria-hidden="true"></span>
              <div class="compare-item">
                <span class="compare-tag compare-tag-accent">映像</span>
                <video src="/media/compare-move-room.mp4" poster="/media/compare-move-room.jpg" muted loop playsinline preload="none" data-autoplay aria-label="同じ洋室を、窓を見ながら部屋の奥へ歩いて映した映像"></video>
              </div>
            </div>
            <figcaption>洋室：窓を見ながら部屋の奥へ進む</figcaption>
          </figure>
        </div>
        <p class="note">この比較は架空の物件で、写真もAIで作ったものです。お手持ちの実写の写真からも同じ手順で作りますが、写真の写り方（明るさ・ゆがみ・生活感）によって仕上がりは変わります。</p>
      </div>
    </section>

    <!-- 制作例 -->
    <section class="section section-tint" id="examples">
      <div class="wrap">
        <p class="eyebrow">制作例</p>
        <h2>実際の住宅の写真15枚から作った例</h2>
        <div class="main-example">
          <YouTube video={MAIN_VIDEO} />
          <div class="main-example-text">
            <p class="example-label">{MAIN_VIDEO.label}</p>
            <p class="example-meta">{MAIN_VIDEO.meta}</p>
            <p>戸建ての1階の室内写真15枚と間取り図から、約139秒の動画にまとめました。玄関から洋室・トイレ・LDK・和室・キッチン・洗面脱衣室・浴室へ、部屋ごとに歩いて見て回ります。各部屋に部屋名のテロップ、冒頭と最後に間取り図と歩く順路のカードを入れ、BGM・環境音・効果音を付けています。</p>
          </div>
        </div>

        <h3 class="sub-heading">料金の目安に合わせた制作例</h3>
        <p class="note note-strong">この3本は架空の物件で、間取り図と室内写真もAIで作ったものです。お手持ちの実写の写真からも同じ手順で作りますが、写真の写り方（明るさ・ゆがみ・生活感）によって仕上がりは変わります。</p>
        <p class="ex-lead">左はお送りいただく間取り図と写真（矢印かスワイプで切り替わります）、右はそこから作った動画です。</p>
        <div class="ex-list">
          {SIZE_VIDEOS.map((v) => <FlowExample video={v} />)}
        </div>
      </div>
    </section>

    <!-- 場面 -->
    <section class="section" id="scenes">
      <div class="wrap">
        <p class="eyebrow">こんなときに</p>
        <h2>このような場面でお使いいただけます</h2>
        <ul class="scene-grid">
          <li class="scene">
            <span class="scene-num">01</span>
            <p>写真はそろっているが、動画の撮影や編集をする時間と担当者がいない</p>
          </li>
          <li class="scene">
            <span class="scene-num">02</span>
            <p>自社サイトやSNS、店頭モニターで、静止画より目を留めてもらえる物件紹介を出したい</p>
          </li>
          <li class="scene">
            <span class="scene-num">03</span>
            <p>空室や遠方の物件で、撮影に行き直す手間をかけずに紹介動画を出したい</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- できること -->
    <section class="section section-tint" id="features">
      <div class="wrap">
        <p class="eyebrow">できること</p>
        <h2>写真と間取り図から、歩いて見て回る映像に</h2>
        <ul class="feature-list">
          <li>
            <h3>部屋の中を歩く</h3>
            <p>部屋ごとに約10秒、部屋の中を歩く映像や、戸口を通って隣の部屋へ入る映像を作り、玄関から順につなぎます。</p>
          </li>
          <li>
            <h3>写真に合わせた部屋の作り</h3>
            <p>間取り図から部屋の立体を起こし、写真に写っている窓・扉・設備の位置に合わせて映像にします。</p>
          </li>
          <li>
            <h3>部屋名と間取りカード</h3>
            <p>各部屋に部屋名のテロップを入れ、冒頭と最後に間取り図と歩く順路のカードを入れます。</p>
          </li>
          <li>
            <h3>BGMと室内の音</h3>
            <p>BGM、部屋ごとの室内の環境音、テロップとカードの効果音を入れます。音なしの版も一緒にお渡しします。</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- 料金 -->
    <section class="section" id="price">
      <div class="wrap">
        <p class="eyebrow">料金</p>
        <h2>料金は写真の枚数で決まります</h2>
        <div class="price-cards">
          {PRICES.slice(0, 4).map((p) => (
            <div class="price-card">
              <p class="price-layout">{p.layout}</p>
              <p class="price-photos">写真{p.photos}</p>
              <p class="price-yen">{p.price}</p>
            </div>
          ))}
        </div>
        <p class="price-extra"><span>{PRICES[4].photos}</span> {PRICES[4].price}（{PRICES[4].layout}）</p>
        <ul class="check-list">
          <li>修正1回（部屋名・順番・カードの文言、区間の撮り直し3区間まで、音を外す・音量を変える）は料金に含まれます。別の音に作り直す場合は、オプション「音の変更」になります</li>
          <li>オプションの追加の修正は2回まで承ります（料金に含まれる1回と合わせて計3回）。それを超える修正は、内容を伺ってお見積りします</li>
          <li>間取り図が無い場合や、寸法も専有面積も読み取れない場合、動画に入れたい部屋の写真が無い場合はお受けできません。作れるかどうかは、写真と間取り図を拝見してご注文の前にお伝えします</li>
        </ul>

        <h3 class="sub-heading">オプション</h3>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th scope="col">内容</th><th scope="col">料金</th></tr></thead>
            <tbody>
              {OPTIONS.map((o) => <tr><td>{o.name}</td><td>{o.price}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p class="note">床材や敷物を別の物に描き替えるご要望は、広告での使い方を伺ってからお受けします。まだ建っていない住宅の完成イメージ動画は、内容を伺ってお見積りします。</p>

        <h3 class="sub-heading">納品物</h3>
        <dl class="spec">
          {DELIVERABLES.map((d) => (<div class="spec-row"><dt>{d.k}</dt><dd>{d.v}</dd></div>))}
        </dl>
      </div>
    </section>

    <!-- 流れ -->
    <section class="section section-tint" id="flow">
      <div class="wrap">
        <p class="eyebrow">制作の流れ</p>
        <h2>資料を受け取ってから、5営業日以内の納品が目安です</h2>
        <ol class="flow">
          {FLOW.map((f, i) => (
            <li class="flow-step">
              <span class="flow-num">{i + 1}</span>
              <div><h3>{f.title}</h3><p>{f.body}</p></div>
            </li>
          ))}
        </ol>

        <div class="prepare">
          <h3>ご用意いただくもの</h3>
          <ul class="check-list">
            <li>動画に入れる部屋すべての室内写真を、各部屋1〜2枚（明るい時間に撮ったものが理想です。ポータルサイトの画面を写したものより、撮影した元の写真のほうが映像がくっきりします）</li>
            <li>間取り図の画像（寸法か専有面積が読み取れるもの。販売図面でもかまいません）</li>
            <li>物件名と、特に見せたい部屋</li>
          </ul>
          <p class="note">私物や生活用品は、できるだけ片付けてから撮ってください。天井の高さや扉の開き方など、写真と間取り図から読み取れない点をお尋ねすることがあります。</p>
        </div>
      </div>
    </section>

    <!-- 注意・条件 -->
    <section class="section" id="terms">
      <div class="wrap">
        <div class="caution">
          <h2 class="caution-title">AIで生成した映像についてのご注意</h2>
          <ul>
            <li>映像はAIで生成したもので、実際に撮影したものではありません。写真をもとにしますが、色・質感・小物などの細部は実物と異なります</li>
            <li>写真に写っていない所（物の陰や、写真の外の壁・天井など）は、間取り図をもとにAIが描きます。鏡の映り込みや小さな金属の設備は、実物と違って見えることがあります。初稿でご確認ください</li>
            <li>寸法や設備の正確さを保証するものではありません。窓・扉・設備が実物どおりかは、納品時にお客さまにもご確認をお願いします</li>
            <li>不動産広告でお使いの際も、画面右上の「AI生成映像」の表示は消さずにお使いください</li>
            <li>音（BGM・環境音・効果音）もAIで作ったものです。環境音は部屋の中の静かな空気の音や換気扇の音だけにしていて、物件の周りの音ではありません</li>
          </ul>
        </div>

        <div class="terms-grid">
          <div>
            <h3>ご利用の条件</h3>
            <ul class="dot-list">
              <li>お送りいただく写真・間取り図は、ご依頼者さまが使用する権利をお持ちのもの（自社物件、施主さまの了承済みのものなど）に限ります</li>
              <li>納品した動画は、ご依頼者さまの物件紹介（自社サイト・SNS・店頭）にお使いいただけます。再販売や素材としての配布はできません</li>
              <li>納品した動画をAIの学習に使うことと、AI生成の表示を消して公開することはお控えください</li>
              <li>動画の音だけを取り出して、別の用途に使うことはご遠慮ください</li>
            </ul>
          </div>
          <div>
            <h3>お預かりする写真・図面の扱い</h3>
            <p>映像の生成は、手元のPCで動かしている動画生成AI「MiniMax H3」で行います。音（BGM・環境音・効果音）は、手元のPCで動かしている音声生成AI「Stable Audio 3」で作ります（Powered by Stability AI）。写真・図面の読み取りと仕上がりの確認には、AIアシスタントを使います。</p>
            <p>写真に写り込んだ物の消去（オプション）には外部の画像編集サービスを使うため、ご注文の前にご相談します。その場合も、施主さまのお名前や住所が分かる部分は消してから渡します。一部の区間を外部の動画生成サービスで仕上げたい場合も、その都度ご了承をいただいてから行います。</p>
            <p>写真の読み取りと写り込みの消去に使うAIサービスは、学習に使わない設定で利用しています。</p>
            <p>お預かりした写真・間取り図と制作データは、納品から30日後に削除します。納品した動画は、受け取り後にお手元で保存してください。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section-tint" id="faq">
      <div class="wrap wrap-narrow">
        <p class="eyebrow">FAQ</p>
        <h2>よくあるご質問</h2>
        <div class="faq">
          {FAQ.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- お問い合わせ -->
    <section class="section contact" id="contact">
      <div class="wrap wrap-narrow">
        <h2>お見積り・ご相談は無料です</h2>
        <p>次の内容をお知らせいただけると、お返事が早くなります。</p>
        <ul class="contact-points">
          <li>物件の種類（戸建て・マンション・店舗など）と間取り</li>
          <li>室内写真の枚数と、間取り図の種類（施工図・販売図面など）</li>
          <li>ご希望の納期</li>
        </ul>
        <div class="contact-cta">
          <a class="btn btn-accent btn-lg" href={SITE.contactUrl}>見積もり・相談のフォームへ</a>
          <p class="contact-mail">メール：<a href={`mailto:${SITE.mail}`}>{SITE.mail}</a></p>
        </div>
        <div class="coconala">
          <p>ココナラからもご依頼いただけます。お支払いとやり取りはココナラの中で行います。料金はこのページと同じです（別にココナラのサービス手数料がかかります）。</p>
          <a class="btn btn-outline" href={SITE.coconalaUrl}>ココナラのサービスページへ</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <a class="mobile-cta btn btn-accent" href={SITE.contactUrl}>無料で見積もりを依頼する</a>
</Base>

<script>
  // 比較の映像は画面に入ったときだけ再生する。動きを減らす設定の閲覧者には自動再生しない
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector<HTMLVideoElement>('.hero-video');
  if (hero && reduce.matches) {
    hero.pause();
    hero.removeAttribute('autoplay');
  }
  const clips = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
  if (!reduce.matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) v.play().catch(() => {});
        else v.pause();
      }
    }, { threshold: 0.4 });
    clips.forEach((v) => io.observe(v));
  } else {
    clips.forEach((v) => v.setAttribute('controls', ''));
  }

  // スマホの下部固定ボタンは、ヒーローと問い合わせ欄が見えている間は隠す
  const cta = document.querySelector<HTMLElement>('.mobile-cta');
  const watch = [document.querySelector('.hero'), document.querySelector('#contact')].filter(Boolean) as Element[];
  if (cta && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io2 = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
      cta.classList.toggle('is-hidden', visible.size > 0);
    });
    watch.forEach((el) => io2.observe(el));
  }
</script>
