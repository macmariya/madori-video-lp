# バリューサーバーの SSH 接続（~/.ssh/config の Host valueserver を使う場合は DEPLOY_HOST=valueserver だけでよい）
DEPLOY_HOST=valueserver
DEPLOY_USER=
DEPLOY_PORT=22
DEPLOY_KEY=
# サブドメインのドキュメントルート（コントロールパネルのサブドメイン設定で確認する）
DEPLOY_PATH=/home/{ユーザー}/public_html/madori.macmariya.com
# フォームの設定と DB を置く場所。ドキュメントルート（public_html）の外にする
PRIVATE_DIR=/home/{ユーザー}/madori-private
# Cloudflare Turnstile（ウィジェットのホスト名は madori.macmariya.com）。サイトキーは公開値、秘密鍵はサーバーの config.php に入る
PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
# 通知の宛先（省略時 info@macmariya.com）
NOTIFY_TO=
